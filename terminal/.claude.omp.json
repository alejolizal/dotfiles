{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#61afef",
          "style": "plain",
          "template": "{{ .Path }}",
          "type": "path",
          "options": {
            "style": "folder"
          }
        },
        {
          "foreground": "#c678dd",
          "style": "plain",
          "template": " \ue725 {{ .HEAD }}{{ if .Staging.Changed }} \u25cf{{ end }}{{ if .Working.Changed }} \u25cb{{ end }}",
          "type": "git",
          "options": {
            "branch_icon": "",
            "fetch_status": true
          }
        },
        {
          "foreground": "#ec2729",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "java"
        },
        {
          "foreground": "#3C873A",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "node"
        },
        {
          "foreground": "#FFE873",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "python"
        },
        {
          "foreground": "#06aad5",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "go"
        },
        {
          "foreground": "#925837",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "rust"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#5c6370",
          "style": "plain",
          "template": "{{ .CurrentDate | date .Format }}",
          "type": "time",
          "options": {
            "time_format": "06.1.2 15:04:05"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#98c379",
          "foreground_templates": ["{{ if gt .Code 0 }}#ef5350{{ end }}"],
          "style": "plain",
          "template": "❯ ",
          "type": "status",
          "options": {
            "always_enabled": true
          }
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
