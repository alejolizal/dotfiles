#!/bin/bash
# =============================================================================
# Hook: pre-push
# Descripción: Previene push accidental a ramas protegidas (develop, main)
# =============================================================================

# URL del remoto (pasada como $2 por git)
REMOTE_URL="$2"

# Permitir push directo a GitHub (repos personales)
if echo "$REMOTE_URL" | grep -q "github.com"; then
    exit 0
fi

# Ramas protegidas (no se permite push directo)
PROTECTED_BRANCHES="^(main|master|develop)$"

# Obtener la rama actual
CURRENT_BRANCH=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

# Leer los refs que se están empujando
while read local_ref local_sha remote_ref remote_sha
do
    # Extraer nombre de la rama remota
    REMOTE_BRANCH=$(echo "$remote_ref" | sed -e 's,.*/\(.*\),\1,')

    # Verificar si se está intentando push a una rama protegida
    if echo "$REMOTE_BRANCH" | grep -qE "$PROTECTED_BRANCHES"; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  ⛔ PUSH BLOQUEADO                                           ║"
        echo "╠══════════════════════════════════════════════════════════════╣"
        echo "║  No se permite push directo a: $REMOTE_BRANCH"
        echo "║                                                              ║"
        echo "║  Para integrar cambios a $REMOTE_BRANCH, usa:                "
        echo "║    • Merge Request (MR) en GitLab                            ║"
        echo "║    • Pull Request (PR) en GitHub                             ║"
        echo "║                                                              ║"
        echo "║  Rama actual: $CURRENT_BRANCH                                "
        echo "║  Usa: git push origin $CURRENT_BRANCH                        "
        echo "╚══════════════════════════════════════════════════════════════╝"
        echo ""
        exit 1
    fi
done

exit 0
